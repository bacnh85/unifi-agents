# UniFi Network Integration API (UniFi OS Server / Network application)
# Create the key in: UniFi Network -> Settings -> Integrations -> API Keys

# Required: API key
UOS_API_KEY=

# Required: base URL of the UniFi OS host (https, self-signed certs are tolerated by default)
UOS_BASE_URL=https://192.168.1.1:443

# Optional: API path prefix BEFORE /v1.
# Default /proxy/network/integration fits UniFi OS consoles (UDM/UNVR/UOS Server).
# Standalone Network application installs: UOS_API_PATH=/integration
# UOS_API_PATH=/proxy/network/integration

# Optional: pin the site instead of auto-detecting (auto works when there is exactly one site)
# UOS_SITE_ID=

# Optional: register only read tools (no restarts, no config changes)
# UOS_READ_ONLY=false

# Optional: enforce TLS certificate validation (default: tolerated for self-signed certs)
# UOS_TLS_STRICT=false
